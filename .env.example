# Copy this file to .env and fill in your values.

# Get a bot token from @BotFather on Telegram (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token-here

# How often (in seconds) the bot checks prices for triggered alerts.
CHECK_INTERVAL_SECONDS=60

# SQLite database file used to persist alerts and watched wallets across restarts.
DATABASE_PATH=alerts.db

# --- Wallet tracking ---
# Solana RPC endpoint. The public one works with no key but is rate-limited;
# for heavier use put a Helius/QuickNode/Triton URL here.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# How often (seconds) to poll watched wallets for new transactions.
WALLET_CHECK_INTERVAL_SECONDS=90

# Optional: a Helius API key (https://helius.dev) unlocks human-readable
# transaction descriptions like "Swapped 1 SOL for 1.2M BONK". Leave blank to
# just get Solscan links.
HELIUS_API_KEY=
